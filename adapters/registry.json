{
  "version": 1,
  "bridgeServerName": "antigravity-mcp-structured-content_bridge",
  "bridgeToolName": "get_structured_result",
  "servers": {
    "cua-driver": {
      "enabled": true,
      "description": "Cua Driver (0.49.x): 补全 browser_* (CDP) 与会话查询工具仅存于 structuredContent 的 tab_id / refs / dialog_id / prepared_pid / 下载与会话元数据；桌面与截图类工具保持 100% 原生直通。",
      "interceptTools": [
        "browser_prepare",
        "get_browser_state",
        "browser_navigate",
        "browser_type",
        "browser_select",
        "browser_click",
        "browser_dialog",
        "browser_set_input_files",
        "browser_download",
        "browser_pointer",
        "get_session",
        "list_sessions"
      ],
      "syncAfterTools": {
        "start_session": {
          "onlyIfActive": false
        },
        "end_session": {
          "onlyIfActive": true
        }
      }
    }
  }
}
